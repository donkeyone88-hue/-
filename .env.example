NODE_ENV=development
PORT=4000

# Comma-separated list of allowed origins. Use * only for local/dev.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiter window in milliseconds and request limit within window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Upstream timeout when contacting Pinterest oEmbed endpoint.
PINTEREST_API_TIMEOUT_MS=7000
